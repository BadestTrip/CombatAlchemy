[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://combat/ui/HeatControl.gd" id="1"]

[sub_resource type="StyleBoxFlat" id="Track"]
bg_color = Color(0.16, 0.16, 0.16, 1)
content_margin_top = 3.0
content_margin_bottom = 3.0

[sub_resource type="StyleBoxFlat" id="Fill"]
bg_color = Color(0.69, 0.69, 0.69, 1)
content_margin_top = 3.0
content_margin_bottom = 3.0

[node name="HeatControl" type="Control"]
custom_minimum_size = Vector2(144, 45)
offset_right = 144.0
offset_bottom = 45.0
mouse_filter = 0
script = ExtResource("1")

[node name="ValueLabel" type="Label" parent="."]
offset_left = 48.0
offset_right = 144.0
offset_bottom = 20.0
mouse_filter = 2
theme_override_font_sizes/font_size = 14
text = "50%"
horizontal_alignment = 1

[node name="FireToggle" type="Button" parent="."]
offset_right = 44.0
offset_bottom = 20.0
focus_mode = 0
mouse_default_cursor_shape = 2
tooltip_text = "Toggle alchemical fire"
toggle_mode = true
text = "OFF"

[node name="Slider" type="HSlider" parent="."]
offset_top = 22.0
offset_right = 144.0
offset_bottom = 45.0
mouse_filter = 0
focus_mode = 0
tooltip_text = "Heat power"
max_value = 1.0
step = 0.05
value = 0.5
theme_override_styles/slider = SubResource("Track")
theme_override_styles/grabber_area = SubResource("Fill")
theme_override_styles/grabber_area_highlight = SubResource("Fill")

[connection signal="value_changed" from="Slider" to="." method="_on_slider_value_changed"]
[connection signal="toggled" from="FireToggle" to="." method="_on_fire_toggle_toggled"]
